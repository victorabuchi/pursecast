// use prisma-8

// One account per person. Everything a user owns will carry userId.

model User {
  id           Uuid               @id @default(uuid())
  email        String             @unique
  name         String
  // ISO 4217 code used for amounts and the forecast.
  currency     String             @default("EUR")
  // IANA zone that decides what "today" is.
  timezone     String             @default("Europe/Helsinki")
  // Account balance in cents as entered by the person, and when. Entries
  // created after balanceSetAt move it. Null until setup is done.
  balance      Int?
  balanceSetAt TimestamptzString?
  // Money Weather treats a day below this (cents) as cloudy.
  cushion      Int                @default(0)
  // Secret iCal address of the person's calendar, read by Plan ahead.
  calendarUrl  String?
  calendarAt   TimestamptzString?
  // The floating note, saved as it is typed.
  notepad      String             @default("")
  notepadAt    TimestamptzString?
  // Profile picture, a small JPEG data: URL. Null shows an empty avatar.
  photo        String?
  // A summary email each Monday morning (needs Resend on the server).
  weeklyEmail  Boolean            @default(false)
  weeklyAt     String?
  createdAt    TimestamptzString  @default(now())
  lastSignInAt TimestamptzString?
  identities   AuthIdentity[]
  categories   Category[]
  entries      Entry[]
  recurring    Recurring[]
  budgetMoves  BudgetMove[]
  forks        Fork[]
  forkEffects  ForkEffect[]
  planEvents   PlanEvent[]
  planItems    PlanItem[]
  debts        Debt[]
  notes        FutureNote[]
  advances     SalaryAdvance[]
  wishes       WishItem[]
  statements   Statement[]
  todos        Todo[]
  aiUsage      AiUsage[]
  pushSubs     PushSub[]
  accounts     Account[]
  bankLinks    BankLink[]
  bankAccounts BankAccount[]
  bankNames    BankName[]
  remindersSent ReminderSent[]
  statementTxns StatementTxn[]

  @@rls
  @@map("app_user")
}

// A way to sign in. provider is 'password' today; 'google' and 'apple' are
// added later as new rows without schema changes. subject is the email for
// passwords and the provider's user id otherwise.
model AuthIdentity {
  id         Uuid               @id @default(uuid())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Uuid
  provider   String
  subject    String
  // scrypt hash, only for provider 'password'.
  secretHash String?
  createdAt  TimestamptzString  @default(now())
  lastUsedAt TimestamptzString?

  @@unique([provider, subject])
  @@index([userId])
  @@rls
  @@map("auth_identity")
}

// One-time sign-in link. Only the SHA-256 of the token is stored.
model LoginToken {
  id        Uuid               @id @default(uuid())
  tokenHash String             @unique
  email     String
  expiresAt TimestamptzString
  usedAt    TimestamptzString?
  createdAt TimestamptzString  @default(now())

  @@index([email])
  @@rls
  @@map("login_token")
}

// Where money goes. kind is 'flex' (everyday spending with a monthly budget),
// 'fixed' (bills) or 'income'. Amounts are cents.
model Category {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  name      String
  kind      String            @default("flex")
  budget    Int               @default(0)
  color     String            @default("#0f7a63")
  position  Int               @default(0)
  createdAt TimestamptzString @default(now())
  entries   Entry[]
  recurring Recurring[]
  moves     BudgetMove[]
  notes     FutureNote[]

  @@unique([userId, name])
  @@rls
  @@map("category")
}

// One logged transaction. amount is cents, negative when money goes out.
// date is the local day (YYYY-MM-DD). mood is the Worth-It rating:
// 'love' | 'meh' | 'regret'.
model Entry {
  id          Uuid               @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  date        String
  amount      Int
  note        String
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Uuid?
  recurring   Recurring?         @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  recurringId Uuid?
  // Money lent, borrowed or paid back.
  debt        Debt?              @relation(fields: [debtId], references: [id], onDelete: SetNull)
  debtId      Uuid?
  mood        String?
  ratedAt     TimestamptzString?
  // "bank" for transactions from a connected bank; externalId says which
  // one (stx:<statement transaction id>) so it is never added twice.
  source      String?
  externalId  String?
  createdAt   TimestamptzString  @default(now())

  @@index([userId, date])
  @@rls
  @@map("entry")
}

// A bill or income that repeats. cadence is 'weekly' | 'biweekly' |
// 'monthly' | 'yearly'. It is posted as an Entry when nextDate arrives.
model Recurring {
  id         Uuid              @id @default(uuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Uuid
  name       String
  amount     Int
  cadence    String            @default("monthly")
  nextDate   String
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Uuid?
  // Paused items are left out of the forecast and not posted until resumed.
  paused     Boolean           @default(false)
  // The price or date is not fixed (cloud hosting, usage billing). amount is
  // an estimate (0 when unknown); nothing is posted automatically, the person
  // logs what it really cost.
  variable   Boolean           @default(false)
  // Comma separated dates (YYYY-MM-DD) skipped once, like a month without
  // an electricity bill.
  skips      String            @default("")
  // Priced in another currency (a dollar Render plan for a euro account):
  // the price as billed, in cents of priceCurrency. amount is that price in
  // the account currency at the latest rate.
  priceCurrency String?
  priceAmount   Int?
  createdAt  TimestamptzString @default(now())
  entries    Entry[]
  advances   SalaryAdvance[]

  @@index([userId])
  @@rls
  @@map("recurring")
}

// Money moved out of a budget. With month (YYYY-MM) it lowers that month
// only (a Money Weather fix); without, it records a permanent Worth-It move
// that was already applied to both budgets.
model BudgetMove {
  id             Uuid              @id @default(uuid())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Uuid
  fromCategory   Category          @relation(fields: [fromCategoryId], references: [id], onDelete: Cascade)
  fromCategoryId Uuid
  toCategoryId   Uuid?
  amount         Int
  month          String?
  reason         String
  createdAt      TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("budget_move")
}

// A "what if" future that runs next to real life from startDate.
model Fork {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  name      String
  // One-off cost (negative) or gain in cents when the fork starts.
  oneTime   Int               @default(0)
  startDate String
  createdAt TimestamptzString @default(now())
  effects   ForkEffect[]

  @@index([userId])
  @@rls
  @@map("fork")
}

// A monthly difference a fork makes, in cents (+ more money, - less).
model ForkEffect {
  id      Uuid   @id @default(uuid())
  fork    Fork   @relation(fields: [forkId], references: [id], onDelete: Cascade)
  forkId  Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Uuid
  name    String
  monthly Int

  @@index([forkId])
  @@rls
  @@map("fork_effect")
}

// Something coming up that will cost money, typed in or read from the
// calendar. Saving sets aside saveMonthly cents on the 1st of each month from
// saveFrom (YYYY-MM) until the event.
model PlanEvent {
  id          Uuid              @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  date        String
  name        String
  tag         String            @default("Other")
  source      String            @default("manual")
  externalId  String?
  hidden      Boolean           @default(false)
  saveMonthly Int?
  saveFrom    String?
  createdAt   TimestamptzString @default(now())
  items       PlanItem[]

  @@unique([userId, externalId])
  @@rls
  @@map("plan_event")
}

// One priced part of a PlanEvent, such as flights or a gift. amount in cents.
model PlanItem {
  id      Uuid      @id @default(uuid())
  event   PlanEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Uuid
  name    String
  amount  Int

  @@index([eventId])
  @@rls
  @@map("plan_item")
}

// Money between the person and someone else. direction is 'lent' (they owe
// you) or 'borrowed' (you owe them). amount is the original sum in cents.
// Paybacks are entries with this debtId going the other way.
model Debt {
  id        Uuid               @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  person    String
  // 'person' or 'institution' (a bank, lender or the tax office).
  party     String             @default("person")
  // A small photo of the person or a logo, as a data: URL.
  photo     String?
  direction String
  amount    Int
  note      String?
  dueDate   String?
  settledAt TimestamptzString?
  createdAt TimestamptzString  @default(now())
  entries   Entry[]

  @@index([userId])
  @@rls
  @@map("debt")
}

// A note to your future self, as text and optionally a short voice
// recording (a data: URL). It plays back before spending in its category, or
// any regretted category when it has none, until the `until` day.
model FutureNote {
  id          Uuid              @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  text        String
  audio       String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Uuid?
  until       String?
  shown       Int               @default(0)
  skipped     Int               @default(0)
  saved       Int               @default(0)
  createdAt   TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("future_note")
}

// Part of a salary paid early. It comes off the pay on `payday`, the date the
// salary was next due when the advance was taken. entryId is the entry that
// brought the money in.
model SalaryAdvance {
  id          Uuid               @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  // The pay it comes off. Null when there is no pay to tie it to (or the
  // pay was removed): the advance is still kept and comes in on its day.
  recurring   Recurring?         @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  recurringId Uuid?
  amount      Int
  takenOn     String
  payday      String
  entryId     Uuid?
  settledAt   TimestamptzString?
  createdAt   TimestamptzString  @default(now())

  @@index([userId])
  @@rls
  @@map("salary_advance")
}

// Something the person wants to buy. price is cents. priority 1 (want most)
// to 3. When they start saving for it, eventId points at the plan event.
model WishItem {
  id        Uuid               @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  name      String
  price     Int
  url       String?
  // A small photo as a data: URL, resized in the browser before upload.
  photo     String?
  priority  Int                @default(2)
  eventId   Uuid?
  boughtAt  TimestamptzString?
  createdAt TimestamptzString  @default(now())

  @@index([userId])
  @@rls
  @@map("wish_item")
}

// An uploaded bank statement, a set of screenshots, or an export file. Its
// transactions are for looking back and do not move the balance.
model Statement {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  name      String
  createdAt TimestamptzString @default(now())
  txns      StatementTxn[]

  @@index([userId])
  @@rls
  @@map("statement")
}

// One transaction read from a statement. amount is cents, negative when
// money went out. category is a category name, place the shop or payer.
model StatementTxn {
  id          Uuid      @id @default(uuid())
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementId Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  date        String
  description String
  place       String
  amount      Int
  category    String

  @@index([userId, date])
  @@index([statementId])
  @@rls
  @@map("statement_txn")
}

// Things to do once money lands: pay the plumber, buy the train ticket. Each
// waits for one income's payday (due), or is for right now (due = the day
// it was added). amount is what it will cost, when known.
model Todo {
  id        Uuid               @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  text      String
  amount    Int?
  // The income it waits for; kept as a plain id so removing it leaves the task.
  incomeId  Uuid?
  due       String
  // 1 must do, 2 should do, 3 nice to do.
  priority  Int                @default(2)
  doneAt    TimestamptzString?
  createdAt TimestamptzString  @default(now())

  @@index([userId])
  @@rls
  @@map("todo")
}

// Calls to Claude per person per day (reading screenshots, PDFs and unusual
// exports), so one account cannot run up the bill.
model AiUsage {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  day       String
  calls     Int               @default(0)
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("ai_usage")
}

// A browser or phone that asked for notifications (web push).
model PushSub {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("push_sub")
}

// Reminders already pushed, by their key, so each goes out once.
model ReminderSent {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  key       String
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("reminder_sent")
}

// Accounts next to the main one (User.balance): savings, a card in another
// currency, cash. balance is in the account's own currency. Ones that count
// add to the balance Money Weather starts from.
model Account {
  id         Uuid              @id @default(uuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Uuid
  name       String
  kind       String            @default("savings")
  currency   String
  balance    Int               @default(0)
  inForecast Boolean           @default(false)
  position   Int               @default(0)
  updatedAt  TimestamptzString @default(now())
  createdAt  TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("account")
}

// A connection to a bank through Enable Banking (open banking). The person
// approves it in their bank; it lasts until validUntil, then needs renewing.
model BankLink {
  id           Uuid               @id @default(uuid())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Uuid
  aspspName    String
  aspspCountry String
  logo         String?
  // Random value that ties the bank's redirect back to this link.
  state        String
  sessionId    String?
  // pending (sent to the bank), active, expired, error
  status       String             @default("pending")
  validUntil   String?
  lastSyncAt   TimestamptzString?
  error        String?
  createdAt    TimestamptzString  @default(now())
  accounts     BankAccount[]

  @@index([userId])
  @@rls
  @@map("bank_link")
}

// An account at a linked bank. role: main (sets the balance Money Weather
// starts from), counted or other (an Account row next to the main one), or
// off. Transactions go to a Statement of its own.
model BankAccount {
  id          Uuid               @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Uuid
  link        BankLink           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId      Uuid
  uid         String
  name        String
  // The account holder's name as the bank gives it, for spotting money sent
  // between the person's own accounts.
  holder      String?
  iban        String?
  currency    String
  balance     Int?
  balanceAt   TimestamptzString?
  role        String             @default("other")
  accountId   Uuid?
  statementId Uuid?
  createdAt   TimestamptzString  @default(now())

  @@index([userId])
  @@index([linkId])
  @@rls
  @@map("bank_account")
}

// Names the person gave linked accounts ("Revolut Pro"), by account number
// and currency, so they survive disconnecting and connecting again.
model BankName {
  id        Uuid              @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Uuid
  iban      String
  currency  String
  name      String
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@rls
  @@map("bank_name")
}
