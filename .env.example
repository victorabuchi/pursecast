# Postgres >= 15. On Supabase use the Session pooler string (port 5432, IPv4):
# the user name must be postgres.<project-ref>. The direct connection is IPv6
# only and does not work from Render.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pursecast"

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Email for sign-in links. Without these, links are shown on the page in development.
RESEND_API_KEY=""
RESEND_FROM="Pursecast <hello@pursecast.com>"

# Optional: national inflation to compare with on Plan ahead, e.g. "3.1".
NATIONAL_INFLATION=""

# Reads screenshots and PDF statements on the Statements page (console.anthropic.com).
# Excel and CSV exports work without it.
ANTHROPIC_API_KEY=""

# Optional: server error alerts to a chat webhook and/or email (email needs RESEND_*).
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
# Claude calls per person per day for reading screenshots and PDFs (default 20).
STATEMENT_AI_DAILY_LIMIT=20
# Database connections per running server (default 4).
DB_POOL_MAX=4
